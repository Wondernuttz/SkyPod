<Window x:Class="Skypod.Studio.AuthorImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyPod — Import Author Project" Width="720" Height="690" MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="{Binding Preview.Library.Name}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Summary}" Margin="0,8,0,14" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Preview.Library.Pack.Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="REQUIRED PLUGINS / MUSIC MODS" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Requirements, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto" Margin="0,6,0,16"/>
            <TextBlock Text="Keep the editable project and its audio in this folder:" TextWrapping="Wrap"/>
            <DockPanel Margin="0,6,0,14"><Button DockPanel.Dock="Right" Content="BROWSE" Click="Folder_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="DestinationBox" Text="{Binding Destination}"/></DockPanel>
            <StackPanel Visibility="{Binding OriginalAudioVisibility}">
                <TextBlock Text="This project references original audio. Choose the folder containing those files:" TextWrapping="Wrap"/>
                <DockPanel Margin="0,6,0,14"><Button DockPanel.Dock="Right" Content="BROWSE" Click="Audio_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="AudioFolderBox"/></DockPanel>
                <TextBlock Text="Subfolders are searched. Audio must match the author's files." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
            </StackPanel>
            <TextBlock Text="{Binding Conflicts}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <CheckBox x:Name="ReplaceBox" Content="Replace matching songs and routes with this project's versions" IsChecked="False"/>
            <TextBlock Text="Unchecked keeps your existing versions. Unrelated songs and assignments stay in your library. Save the merged library, then rebuild for your modlist."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CANCEL" IsCancel="True"/>
            <Button Content="IMPORT AND MERGE" Click="Import_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
